{
  "steps": [
    {
      "stepRunnerKey": "sys:comment",
      "note": "PSMenu 独立版：确保最新 → 安装/更新 → 常驻启动或唤出菜单（纯模块流，无脚本）"
    },
    {
      "stepRunnerKey": "sys:stateStorage",
      "inputParams": {
        "type": "readActionState",
        "key": "installDir"
      },
      "outputParams": {
        "value": "已选安装目录"
      },
      "note": "读用户自选的安装位置（没选过就是空）"
    },
    {
      "stepRunnerKey": "sys:getFolderPath",
      "inputParams": {
        "folder": "LocalApplicationData"
      },
      "outputParams": {
        "path": "本地AppData"
      },
      "note": "取 %LOCALAPPDATA%。原先默认值是写死的作者机器路径（C:\\Users\\EDY\\...），别人装上去根本不存在"
    },
    {
      "stepRunnerKey": "sys:assign",
      "inputParams": {
        "input": "$=string.IsNullOrWhiteSpace({已选安装目录}) ? System.IO.Path.Combine({本地AppData}, \"PSMenu\", \"app\") : {已选安装目录}"
      },
      "outputParams": {
        "output": "安装目录"
      },
      "note": "默认装到 %LOCALAPPDATA%\\PSMenu\\app；用户自己选过就用用户的"
    },
    {
      "stepRunnerKey": "sys:checkPathExists",
      "inputParams": {
        "path": "$${安装目录}\\PSMenu.exe"
      },
      "outputParams": {
        "isExists": "已安装"
      },
      "note": "是否已安装（提前到分支之前：下面几个入口都要用它判断）"
    },
    {
      "stepRunnerKey": "sys:simpleIf",
      "inputParams": {
        "condition": "$=!{已安装}"
      },
      "note": "第一次装：先问装哪儿，别一声不响就装到默认位置",
      "ifSteps": [
        {
          "stepRunnerKey": "sys:MsgBox",
          "inputParams": {
            "operation": "custom",
            "title": "装到哪里？",
            "message": "$$还没有装 PS便捷菜单，先定个位置。\n\n默认位置（推荐）：\n{安装目录}\n\n放这儿的好处是跟着你的用户配置走，不用管。\n想放到别的盘或别的目录，就选下面第二项。",
            "icon": "Question",
            "customButtons": "[fa:Light_Home:#0A66C2]用默认位置|default\n[fa:Light_FolderOpen:#4F46E5]我自己选一个|choose",
            "defaultButton": "default"
          },
          "outputParams": {
            "result": "位置选择"
          },
          "note": "两个选项都给明确；默认停在「用默认位置」"
        },
        {
          "stepRunnerKey": "sys:strCompare",
          "inputParams": {
            "param1.var": "位置选择",
            "type": "=",
            "param2": "choose",
            "case": "0"
          },
          "outputParams": {
            "value": "要自己选"
          },
          "note": "选了「我自己选一个」才弹文件夹框"
        },
        {
          "stepRunnerKey": "sys:simpleIf",
          "inputParams": {
            "condition": "$={要自己选}"
          },
          "ifSteps": [
            {
              "stepRunnerKey": "sys:selectFolder",
              "inputParams": {
                "prompt": "选一个固定位置存放 PSMenu（别选桌面／临时目录）",
                "initDir.var": "本地AppData",
                "stopIfFail": "0"
              },
              "outputParams": {
                "isSuccess": "选好了",
                "path": "选的目录"
              },
              "note": "弹文件夹选择框"
            },
            {
              "stepRunnerKey": "sys:assign",
              "inputParams": {
                "input": "$=string.IsNullOrWhiteSpace({选的目录}) ? {安装目录} : System.IO.Path.Combine({选的目录}, \"PSMenu\", \"app\")"
              },
              "outputParams": {
                "output": "安装目录"
              },
              "note": "取消选择就退回默认位置；选中了就在其下再建一层 PSMenu\\app，不把文件铺在用户选的目录里"
            },
            {
              "stepRunnerKey": "sys:stateStorage",
              "inputParams": {
                "type": "saveActionState",
                "key": "installDir",
                "value.var": "安装目录"
              },
              "note": "记住位置，下次不再问"
            }
          ]
        }
      ]
    },
    {
      "stepRunnerKey": "sys:strCompare",
      "inputParams": {
        "param1.var": "quicker_in_param",
        "type": "=",
        "param2": "setpath",
        "case": "0"
      },
      "outputParams": {
        "value": "是设路径"
      },
      "note": "右键菜单入口 1：选择安装位置"
    },
    {
      "stepRunnerKey": "sys:simpleIf",
      "inputParams": {
        "condition": "$={是设路径}"
      },
      "note": "选安装位置：选完记住并结束，不走启动流程",
      "ifSteps": [
        {
          "stepRunnerKey": "sys:selectFolder",
          "inputParams": {
            "prompt": "选一个固定位置存放 PSMenu（别选桌面／临时目录）",
            "initDir.var": "本地AppData",
            "stopIfFail": "0"
          },
          "outputParams": {
            "isSuccess": "选好了",
            "path": "选的目录"
          },
          "note": "弹文件夹选择框"
        },
        {
          "stepRunnerKey": "sys:simpleIf",
          "inputParams": {
            "condition": "$={选好了}"
          },
          "note": "真选了才写；点了取消就什么都不做",
          "ifSteps": [
            {
              "stepRunnerKey": "sys:assign",
              "inputParams": {
                "input": "$=System.IO.Path.Combine({选的目录}, \"PSMenu\", \"app\")"
              },
              "outputParams": {
                "output": "新安装目录"
              },
              "note": "在选中目录下再建一层 PSMenu\\app，不把文件铺在用户选的目录里"
            },
            {
              "stepRunnerKey": "sys:stateStorage",
              "inputParams": {
                "type": "saveActionState",
                "key": "installDir",
                "value.var": "新安装目录"
              },
              "note": "记住这个位置"
            },
            {
              "stepRunnerKey": "sys:MsgBox",
              "inputParams": {
                "operation": "default",
                "title": "安装位置已记住",
                "message": "$$以后会装到：\n{新安装目录}\n\n再点一次动作，它就会下载并启动到新位置。\n如果原来装在别处，旧的那份要自己删掉。",
                "icon": "Information",
                "buttons": "OK"
              },
              "note": "把新位置明确告诉用户"
            }
          ]
        },
        {
          "stepRunnerKey": "sys:stop",
          "inputParams": {
            "method": "default",
            "isError": "0",
            "return": "OK: path set"
          },
          "note": "设完即止"
        }
      ]
    },
    {
      "stepRunnerKey": "sys:strCompare",
      "inputParams": {
        "param1.var": "quicker_in_param",
        "type": "=",
        "param2": "uninstall",
        "case": "0"
      },
      "outputParams": {
        "value": "是卸载"
      },
      "note": "右键菜单入口 2：卸载（动作被删之前先把软件请干净）"
    },
    {
      "stepRunnerKey": "sys:simpleIf",
      "inputParams": {
        "condition": "$={是卸载}"
      },
      "note": "卸载流程：全程只移入回收站，误删能捞回来",
      "ifSteps": [
        {
          "stepRunnerKey": "sys:MsgBox",
          "inputParams": {
            "operation": "default",
            "title": "卸载 PS便捷菜单",
            "message": "$$要卸载 PS便捷菜单吗？\n\n会做这几件事：\n· 关掉正在运行的菜单程序\n· 取消开机自启\n· 删掉桌面快捷方式\n· 程序文件移入回收站（可恢复）\n\n当前安装位置：\n{安装目录}",
            "icon": "Warning",
            "buttons": "YesNo",
            "defaultButton": "No"
          },
          "outputParams": {
            "okOrYes": "确认卸载"
          },
          "note": "卸载不可轻率，先问一遍；默认停在「否」，回车不会误删"
        },
        {
          "stepRunnerKey": "sys:simpleIf",
          "inputParams": {
            "condition": "$=!{确认卸载}"
          },
          "note": "点否就什么都不做",
          "ifSteps": [
            {
              "stepRunnerKey": "sys:stop",
              "inputParams": {
                "method": "default",
                "isError": "0",
                "return": "Cancelled"
              }
            }
          ]
        },
        {
          "stepRunnerKey": "sys:run",
          "inputParams": {
            "path": "taskkill",
            "arg": "/IM PSMenu.exe /F",
            "waitExit": "1",
            "stopIfFail": "0"
          },
          "note": "先结束常驻实例：它不退出的话文件被占用，移不进回收站"
        },
        {
          "stepRunnerKey": "sys:delay",
          "inputParams": {
            "delayMs": "900"
          },
          "note": "等文件锁释放"
        },
        {
          "stepRunnerKey": "sys:run",
          "inputParams": {
            "path": "reg",
            "arg": "delete \"HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\" /v PSMenu /f",
            "waitExit": "1",
            "stopIfFail": "0"
          },
          "note": "取消开机自启（程序自己写的是 HKCU\\...\\Run 下的 PSMenu 值）"
        },
        {
          "stepRunnerKey": "sys:getFolderPath",
          "inputParams": {
            "folder": "Desktop"
          },
          "outputParams": {
            "path": "桌面目录"
          },
          "note": "取桌面路径"
        },
        {
          "stepRunnerKey": "sys:fileOperation",
          "inputParams": {
            "type": "recycleNoUi",
            "path": "$${桌面目录}\\PS便捷菜单.lnk",
            "stopIfFail": "0"
          },
          "note": "桌面快捷方式移入回收站（没有这个文件就静默跳过）"
        },
        {
          "stepRunnerKey": "sys:fileOperation",
          "inputParams": {
            "type": "recycleNoUi",
            "path": "$${安装目录}",
            "stopIfFail": "0"
          },
          "note": "程序文件移入回收站"
        },
        {
          "stepRunnerKey": "sys:MsgBox",
          "inputParams": {
            "operation": "default",
            "title": "菜单配置怎么处理",
            "message": "程序文件已经清掉了。\n\n你调好的菜单还留在 %APPDATA%\\PSMenu，要一起删吗？\n\n· 选「否」＝ 留着。以后重装还认得你的菜单和置顶\n· 选「是」＝ 一起删掉，重装就是全新的",
            "icon": "Question",
            "buttons": "YesNo",
            "defaultButton": "No"
          },
          "outputParams": {
            "okOrYes": "连配置一起删"
          },
          "note": "配置是用户自己调出来的劳动成果，默认留在「否」。这一条曾经没设默认按钮、回车即删，实测把配置删进过回收站——破坏性动作的默认值必须是安全的那一侧"
        },
        {
          "stepRunnerKey": "sys:simpleIf",
          "inputParams": {
            "condition": "$={连配置一起删}"
          },
          "ifSteps": [
            {
              "stepRunnerKey": "sys:getFolderPath",
              "inputParams": {
                "folder": "ApplicationData"
              },
              "outputParams": {
                "path": "漫游AppData"
              },
              "note": "配置在 Roaming\\PSMenu"
            },
            {
              "stepRunnerKey": "sys:fileOperation",
              "inputParams": {
                "type": "recycleNoUi",
                "path": "$${漫游AppData}\\PSMenu",
                "stopIfFail": "0"
              },
              "note": "配置目录移入回收站"
            }
          ]
        },
        {
          "stepRunnerKey": "sys:stateStorage",
          "inputParams": {
            "type": "saveActionState",
            "key": "installDir",
            "value": "*NULL*"
          },
          "note": "清掉记住的安装位置，免得下次又装回老地方"
        },
        {
          "stepRunnerKey": "sys:stateStorage",
          "inputParams": {
            "type": "UpdateActionBadge"
          },
          "note": "清掉动作上的版本徽标"
        },
        {
          "stepRunnerKey": "sys:notify",
          "inputParams": {
            "type": "Success",
            "msg": "PS便捷菜单 已卸载（程序和快捷方式都进回收站了）"
          },
          "note": "告诉用户完事了"
        },
        {
          "stepRunnerKey": "sys:stop",
          "inputParams": {
            "method": "default",
            "isError": "0",
            "return": "Uninstalled"
          }
        }
      ]
    },
    {
      "stepRunnerKey": "sys:fileOperation",
      "inputParams": {
        "type": "makeDir",
        "path": "$${安装目录}",
        "stopIfFail": "0"
      },
      "note": "确保安装目录存在"
    },
    {
      "stepRunnerKey": "sys:readFile",
      "inputParams": {
        "type": "text",
        "path": "$${安装目录}\\version.txt",
        "encoding": "utf-8",
        "stopIfFail": "0"
      },
      "outputParams": {
        "txt": "本地版本"
      },
      "note": "读取本地已装版本"
    },
    {
      "stepRunnerKey": "sys:http",
      "inputParams": {
        "url": "https://gitee.com/weizhiOWO/quicker-actions/raw/main/psmenu/latest.json",
        "method": "GET",
        "resultType": "Text",
        "expireSeconds": "6",
        "stopIfFail": "0"
      },
      "outputParams": {
        "content": "清单文本"
      },
      "note": "拉取 Gitee 分发仓版本清单"
    },
    {
      "stepRunnerKey": "sys:simpleIf",
      "inputParams": {
        "condition": "$=!string.IsNullOrEmpty({清单文本})"
      },
      "note": "拿到清单才做更新；拿不到则走离线兜底",
      "ifSteps": [
        {
          "stepRunnerKey": "sys:jsonExtract",
          "inputParams": {
            "data.var": "清单文本",
            "p0": "version",
            "p1": "files[0].url",
            "p2": "files[0].fallbackUrl",
            "p3": "files[0].sha256",
            "stopIfFail": "0"
          },
          "outputParams": {
            "v0": "远端版本",
            "v1": "下载URL",
            "v2": "备用URL",
            "v3": "期望sha"
          },
          "note": "解析清单：版本 / 主源 / 备源 / 校验值"
        },
        {
          "stepRunnerKey": "sys:strCompare",
          "inputParams": {
            "param1.var": "本地版本",
            "type": "=",
            "param2.var": "远端版本",
            "case": "0"
          },
          "outputParams": {
            "value": "版本相同"
          },
          "note": "本地版本是否已是远端版本"
        },
        {
          "stepRunnerKey": "sys:strCompare",
          "inputParams": {
            "param1.var": "quicker_in_param",
            "type": "=",
            "param2": "update",
            "case": "0"
          },
          "outputParams": {
            "value": "强制更新"
          },
          "note": "是否强制更新（传参 update）"
        },
        {
          "stepRunnerKey": "sys:simpleIf",
          "inputParams": {
            "condition": "$=!{已安装} || !{版本相同} || {强制更新}"
          },
          "note": "未安装、版本落后或强制更新时才下载",
          "ifSteps": [
            {
              "stepRunnerKey": "sys:download",
              "inputParams": {
                "url.var": "下载URL",
                "savePath": "$${临时目录}",
                "saveName": "psmenu_standalone.zip",
                "expireSeconds": "60",
                "showProgress": "1",
                "stopIfFail": "0"
              },
              "outputParams": {
                "isSuccess": "下载成功"
              },
              "note": "主源下载（Gitee）"
            },
            {
              "stepRunnerKey": "sys:simpleIf",
              "inputParams": {
                "condition": "$=!{下载成功}"
              },
              "note": "主源失败则换备用源（GitHub）",
              "ifSteps": [
                {
                  "stepRunnerKey": "sys:download",
                  "inputParams": {
                    "url.var": "备用URL",
                    "savePath": "$${临时目录}",
                    "saveName": "psmenu_standalone.zip",
                    "expireSeconds": "60",
                    "showProgress": "1",
                    "stopIfFail": "0"
                  },
                  "outputParams": {
                    "isSuccess": "下载成功"
                  },
                  "note": "备用源下载"
                }
              ]
            },
            {
              "stepRunnerKey": "sys:simpleIf",
              "inputParams": {
                "condition": "$=!{下载成功}"
              },
              "note": "两个源都失败：明确报错并中止",
              "ifSteps": [
                {
                  "stepRunnerKey": "sys:notify",
                  "inputParams": {
                    "type": "Error",
                    "msg": "PSMenu 更新包下载失败（Gitee 与 GitHub 均不可用）"
                  }
                },
                {
                  "stepRunnerKey": "sys:stop",
                  "inputParams": {
                    "method": "default",
                    "isError": "1",
                    "return": "ERR: download failed"
                  }
                }
              ]
            },
            {
              "stepRunnerKey": "sys:checkPathExists",
              "inputParams": {
                "path": "$${更新包路径}"
              },
              "outputParams": {
                "sha256hash": "实际sha"
              },
              "note": "取下载包的 SHA256"
            },
            {
              "stepRunnerKey": "sys:strCompare",
              "inputParams": {
                "param1.var": "实际sha",
                "type": "=",
                "param2.var": "期望sha",
                "case": "0"
              },
              "outputParams": {
                "value": "校验通过"
              },
              "note": "下载包哈希是否与清单一致"
            },
            {
              "stepRunnerKey": "sys:simpleIf",
              "inputParams": {
                "condition": "$=!{校验通过}"
              },
              "note": "完整性校验不通过即中止（防劫持/半包）",
              "ifSteps": [
                {
                  "stepRunnerKey": "sys:notify",
                  "inputParams": {
                    "type": "Error",
                    "msg": "PSMenu 更新包校验不通过（SHA256 不匹配），已中止"
                  }
                },
                {
                  "stepRunnerKey": "sys:stop",
                  "inputParams": {
                    "method": "default",
                    "isError": "1",
                    "return": "ERR: sha256 mismatch"
                  }
                }
              ]
            },
            {
              "stepRunnerKey": "sys:checkProcessExists",
              "inputParams": {
                "process": "PSMenu",
                "stopIfFail": "0"
              },
              "outputParams": {
                "isExists": "进程在跑"
              },
              "note": "更新前检查是否在运行"
            },
            {
              "stepRunnerKey": "sys:simpleIf",
              "inputParams": {
                "condition": "$={进程在跑}"
              },
              "note": "在运行则先退出，否则 exe/dll 被占用无法覆盖",
              "ifSteps": [
                {
                  "stepRunnerKey": "sys:run",
                  "inputParams": {
                    "path": "taskkill",
                    "arg": "/IM PSMenu.exe /F",
                    "waitExit": "1",
                    "stopIfFail": "0"
                  },
                  "note": "结束常驻实例"
                },
                {
                  "stepRunnerKey": "sys:delay",
                  "inputParams": {
                    "delayMs": "800"
                  },
                  "note": "等文件锁释放"
                }
              ]
            },
            {
              "stepRunnerKey": "sys:zip",
              "inputParams": {
                "type": "Unzip",
                "sourceZipFile": "$${更新包路径}",
                "outputPath": "$${安装目录}",
                "overwrite": "1",
                "showProgress": "1",
                "stopIfFail": "0"
              },
              "note": "解压覆盖到安装目录"
            },
            {
              "stepRunnerKey": "sys:WriteTextFile",
              "inputParams": {
                "content.var": "远端版本",
                "filePath": "$${安装目录}\\version.txt",
                "encoding": "utf-8",
                "addUtf8Bom": "0",
                "stopIfFail": "0"
              },
              "note": "回写版本号（不加 BOM，否则下次比对永不相等）"
            },
            {
              "stepRunnerKey": "sys:stateStorage",
              "inputParams": {
                "type": "UpdateActionBadge",
                "badgeText": "$$v{远端版本}"
              },
              "note": "动作徽标显示当前版本"
            },
            {
              "stepRunnerKey": "sys:notify",
              "inputParams": {
                "type": "Success",
                "msg": "$$PSMenu 已更新到 v{远端版本}"
              },
              "note": "更新完成反馈"
            }
          ]
        }
      ]
    },
    {
      "stepRunnerKey": "sys:simpleIf",
      "inputParams": {
        "condition": "$=!{已安装} && string.IsNullOrEmpty({清单文本})"
      },
      "note": "离线且从未装过：没有可启动的东西，明确报错",
      "ifSteps": [
        {
          "stepRunnerKey": "sys:notify",
          "inputParams": {
            "type": "Error",
            "msg": "PSMenu 尚未安装，且无法连接更新服务器，请检查网络"
          }
        },
        {
          "stepRunnerKey": "sys:stop",
          "inputParams": {
            "method": "default",
            "isError": "1",
            "return": "ERR: offline and not installed"
          }
        }
      ]
    },
    {
      "stepRunnerKey": "sys:checkProcessExists",
      "inputParams": {
        "process": "PSMenu",
        "stopIfFail": "0"
      },
      "outputParams": {
        "isExists": "进程在跑"
      },
      "note": "启动前检查常驻实例"
